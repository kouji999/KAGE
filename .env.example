# --- Storage / session ---
KAGE_DB_PATH=./data/kage.db
KAGE_AUTH_DIR=./auth

# --- Owner API + panel ---
KAGE_API_HOST=127.0.0.1
KAGE_API_PORT=4660
KAGE_API_TOKEN=change…oken

# --- Owner identity ---
# Full international number, no +, no leading 0. 0877... -> 62877...
KAGE_OWNER_PHONE=6287726681286
KAGE_DEFAULT_MODE=AUTO

# --- LLM (chat) — OpenAI-compatible ---
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_API_KEY=sk-you…-key
LLM_MODEL=z-ai/glm-5.3-free
LLM_MAX_TOKENS=700
LLM_MONTHLY_BUDGET_USD=20

# --- Voice (TTS) — OpenRouter audio output ---
VOICE_ENABLED=true
VOICE_BASE_URL=https://openrouter.ai/api/v1
VOICE_API_KEY=sk-or-…-key
VOICE_MODEL=deepgram/flux-tts:free
VOICE_NAME=flux-donovan-en

# --- Rate limiting (stability, NOT enforcement evasion) ---
RATE_WINDOW_MS=60000
RATE_MAX_PER_WINDOW=8

# --- Resilience ---
RECONNECT_MAX_ATTEMPTS=5
SEND_MAX_ATTEMPTS=3

LOG_LEVEL=info

# text = default (voice hanya via flag owner), voice = selalu coba voice note, both = teks + voice
VOICE_MODE=text

# --- Backup LLM (opsional): 9router lokal / provider lain ---
# LLM_FALLBACK_BASE_URL=http://127.0.0.1:20128/v1
# LLM_FALLBACK_MODEL=tokenrouter/z-ai/glm-5.3-free
# LLM_FALLBACK_API_KEY=sk-...  (kosong = pakai env DEVSTACK_API_KEY bila ada)
